---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import featured from '../data/featured.json';
import { byNewest } from '../utils/date';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(byNewest);
const latest = posts.slice(0, 3);
const interests = Object.entries(profile.interests);
// Contact links come from Notion (Tag=Contact) as an ordered array; render them
// two-per-row like the original SpaceHey box, padding the last row so the fixed
// table layout keeps both columns the same width on an odd count.
const contact = Array.isArray(profile.contact) ? profile.contact : [];
// "Top Stuff" — own posts, projects, and outbound links, all from Notion.
const featuredItems = featured.items ?? [];
const featuredHeading = profile.featured?.heading || `${profile.name}'s Top Stuff`;
const featuredViewAll = profile.featured?.viewAll || '';
const contactRows = Array.from({ length: Math.ceil(contact.length / 2) }, (_, i) =>
  contact.slice(i * 2, i * 2 + 2)
);
const details = Object.entries(profile.details);
// About me comes from the Notion page BODY rather than a single-line property,
// so it can arrive as several paragraphs — split them out instead of letting
// HTML collapse the blank lines into one run-on blurb.
const aboutParas = String(profile.about ?? '')
  .split(/\n{2,}/)
  .map((p) => p.trim())
  .filter(Boolean);
---
<BaseLayout title="Zack's Profile | mehhspace" active="home">
  <div class="row profile">

    <!-- LEFT COLUMN -->
    <div class="col w-40 left">
      <h1>{profile.name}</h1>

      <div class="general-about">
        <div class="profile-pic">
          <img src={profile.profilePic} alt={`${profile.name}'s profile picture`} />
        </div>
        <div class="details">
          {profile.online && <p class="online">● ONLINE!</p>}
        </div>
      </div>

      <div class="mood">
        <p><b>Mood:</b> {profile.mood}</p>
        <p><b>View my: <a href="/blog">Blog</a> | <a href="/lab">Lab</a> | <a href="/resume">Resume</a></b></p>
      </div>

      <div class="contact">
        <div class="heading"><h4>Contacting {profile.name}</h4></div>
        <div class="inner">
          {contactRows.map((pair) => (
            <div class="f-row">
              {pair.map((link) => (
                <div class="f-col"><a href={link.href}>{link.label}</a></div>
              ))}
              {pair.length === 1 && <div class="f-col" />}
            </div>
          ))}
        </div>
      </div>

      <div class="url-info">
        <p><b>mehhspace URL:</b></p>
        <p>{profile.url}</p>
      </div>

      <div class="table-section">
        <div class="heading"><h4>{profile.name}'s Interests</h4></div>
        <div class="inner">
          <table class="details-table">
            <tbody>
              {interests.map(([label, value]) => (
                <tr><td>{label}</td><td><p>{value}</p></td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="table-section">
        <div class="heading"><h4>{profile.name}'s Details</h4></div>
        <div class="inner">
          <table class="details-table">
            <tbody>
              {details.map(([label, value]) => (
                <tr><td>{label}</td><td>{value}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col right">
      <div class="blog-preview">
        <h4>{profile.name}'s Latest Blog Entries [<a href="/blog">View Blog</a>]</h4>
        {latest.map((post) => (
          <p>{post.data.title} (<a href={`/blog/${post.id}`}>view more</a>)</p>
        ))}
      </div>

      <div class="blurbs">
        <div class="heading"><h4>{profile.name}'s Blurbs</h4></div>
        <div class="inner">
          <div class="section">
            <h4>About me:</h4>
            {aboutParas.map((para) => <p>{para}</p>)}
          </div>
          <div class="section">
            <h4>Who I'd like to meet:</h4>
            <p>{profile.whoMeet}</p>
          </div>
        </div>
      </div>

      <div class="friends">
        <div class="heading">
          <h4>{featuredHeading}</h4>
          {featuredViewAll && <a class="more" href={featuredViewAll}>[view all]</a>}
        </div>
        <div class="inner">
          <p><b>{profile.name} has <span class="count">{featuredItems.length}</span> things featured.</b></p>
          <div class="friends-grid">
            {featuredItems.map((item) => {
              // Outbound tiles open in a new tab and get the little arrow, so it's
              // obvious which squares leave mehhspace.
              const out = item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
              return (
                <div class="person">
                  <a href={item.href} {...out}>
                    <p>{item.title}{item.external && <span class="ext">↗</span>}</p>
                  </a>
                  <a href={item.href} {...out}><img src={item.image} alt={item.title} /></a>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
