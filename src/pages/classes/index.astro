---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SideProfile from '../../components/SideProfile.astro';
import { byNewest, timeAgo } from '../../utils/date';

const posts = (await getCollection('classes', ({ data }) => !data.draft)).sort(byNewest);

// Group by category — for Classes the category IS the class name. Rows that
// never got one still render, under a catch-all group.
const groups = new Map<string, typeof posts>();
for (const post of posts) {
  const cat = post.data.category ?? 'Unsorted';
  if (!groups.has(cat)) groups.set(cat, []);
  groups.get(cat)!.push(post);
}
const categories = [...groups.entries()];
---
<BaseLayout title="Zack's Classes | mehhspace" active="classes">
  <div class="row profile">

    <!-- LEFT COLUMN -->
    <div class="col w-30 left">
      <SideProfile>
        <div class="url-info">
          <p><b>View my:</b></p>
          <p><a href="/">Profile</a> | <a href="/blog">Blog</a> | <a href="/lab">Lab</a></p>
        </div>
      </SideProfile>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="col right">
      <div class="page-intro">
        <h2>Classes</h2>
        <p>Coursework, certs, and whatever I'm studying at the moment. Notes are grouped by class —
        pick one below or just scroll.</p>
      </div>

      {posts.length === 0 ? (
        <div class="blog-entries">
          <div class="entry"><div class="inner"><p>Nothing here yet — check back soon.</p></div></div>
        </div>
      ) : (
        <>
          <div class="category-grid">
            {categories.map(([cat, items]) => (
              <a class="category-tag" href={`#${cat.toLowerCase()}`}>{cat} <span class="count">({items.length})</span></a>
            ))}
          </div>

          {categories.map(([cat, items]) => (
            <div class="cat-section" id={cat.toLowerCase()}>
              <div class="heading">
                <h4>{cat}</h4>
                <span class="tag-label">{items.length} post{items.length === 1 ? '' : 's'}</span>
              </div>
              <div class="inner">
                <div class="cat-entries">
                  {items.map((post) => (
                    <div class="entry">
                      <h3 class="title"><a href={`/classes/${post.id}`}>{post.data.title}</a></h3>
                      <p class="meta">{timeAgo(post.data.date)}</p>
                      {post.data.excerpt && <p class="excerpt">{post.data.excerpt}</p>}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </>
      )}
    </div>
  </div>
</BaseLayout>
